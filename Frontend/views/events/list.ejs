<%- include('../partials/header') %>

<div class="container py-4">
  <!-- Page Header -->
  <div class="row align-items-center mb-4">
    <div class="col-md-6">
      <h2 class="fw-bold mb-1">Explore College Events</h2>
      <p class="text-muted mb-0">Browse through academic conferences, hackathons, and cultural fests.</p>
    </div>
    <div class="col-md-6 text-md-end mt-3 mt-md-0">
      <% if (currentAdmin) { %>
        <a href="/admin/events/new" class="btn btn-warning fw-semibold shadow-sm">
          <i class="bi bi-plus-circle me-1"></i> Create New Event
        </a>
      <% } %>
    </div>
  </div>

  <!-- Search & Filter Card -->
  <div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3 p-md-4">
      <form action="/events" method="GET" class="row g-3">
        <div class="col-lg-5">
          <div class="input-group">
            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
            <input type="text" name="search" class="form-control" placeholder="Search by title, organizer, or keywords..." value="<%= selectedSearch %>">
          </div>
        </div>

        <div class="col-md-4 col-lg-3">
          <select name="category" class="form-select">
            <option value="All" <%= selectedCategory === 'All' ? 'selected' : '' %>>All Categories</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-4 col-lg-2">
          <select name="status" class="form-select">
            <option value="All" <%= selectedStatus === 'All' ? 'selected' : '' %>>All Statuses</option>
            <option value="Upcoming" <%= selectedStatus === 'Upcoming' ? 'selected' : '' %>>Upcoming</option>
            <option value="Ongoing" <%= selectedStatus === 'Ongoing' ? 'selected' : '' %>>Ongoing</option>
            <option value="Completed" <%= selectedStatus === 'Completed' ? 'selected' : '' %>>Completed</option>
          </select>
        </div>

        <div class="col-md-4 col-lg-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary w-100 fw-semibold">
            <i class="bi bi-funnel me-1"></i> Filter
          </button>
          <% if (selectedSearch || selectedCategory !== 'All' || selectedStatus !== 'All') { %>
            <a href="/events" class="btn btn-outline-secondary" title="Reset Filters">
              <i class="bi bi-arrow-clockwise"></i>
            </a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <!-- Events Grid -->
  <div class="row g-4">
    <% if (events && events.length > 0) { %>
      <% events.forEach(event => { %>
        <div class="col-md-6 col-lg-4">
          <div class="card event-card h-100 position-relative shadow-sm">
            <img src="<%= event.banner_image || 'https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=800&q=80' %>" class="card-img-top event-card-img" alt="<%= event.title %>">
            <span class="event-category-badge"><%= event.category %></span>

            <div class="card-body d-flex flex-column">
              <div class="d-flex align-items-center gap-2 small text-muted mb-2">
                <span><i class="bi bi-calendar3 me-1 text-primary"></i><%= event.event_date %></span>
                <span>&bull;</span>
                <span><i class="bi bi-clock me-1 text-primary"></i><%= event.event_time %></span>
              </div>

              <h5 class="card-title fw-bold text-dark mb-2">
                <a href="/events/<%= event.id %>" class="text-decoration-none text-dark hover-primary"><%= event.title %></a>
              </h5>

              <p class="card-text text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                <%= event.description %>
              </p>

              <div class="border-top pt-3 mt-auto">
                <div class="d-flex justify-content-between align-items-center mb-2 small">
                  <span class="text-secondary text-truncate" style="max-width: 60%;">
                    <i class="bi bi-geo-alt-fill text-danger me-1"></i><%= event.venue_name || 'Campus Venue' %>
                  </span>
                  <span class="badge <%= event.registered_count >= event.max_participants ? 'bg-danger' : 'bg-light text-dark border' %>">
                    <%= event.registered_count %> / <%= event.max_participants %> slots
                  </span>
                </div>

                <!-- Registration Capacity Progress Bar -->
                <% const percent = Math.min(Math.round((event.registered_count / event.max_participants) * 100), 100); %>
                <div class="progress mb-3" style="height: 5px;">
                  <div class="progress-bar <%= percent >= 90 ? 'bg-danger' : 'bg-primary' %>" role="progressbar" style="width: <%= percent %>%;"></div>
                </div>

                <a href="/events/<%= event.id %>" class="btn btn-primary w-100 fw-semibold">
                  <i class="bi bi-eye me-1"></i> View Details & Register
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col-12 text-center py-5">
        <div class="card border-0 shadow-sm p-5">
          <i class="bi bi-search fs-1 text-muted mb-3"></i>
          <h4 class="fw-bold">No Events Found</h4>
          <p class="text-muted">No events match your current filter criteria. Try adjusting your search query or reset filters.</p>
          <div>
            <a href="/events" class="btn btn-outline-primary">Reset Filters</a>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
