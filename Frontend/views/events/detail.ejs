<%- include('../partials/header') %>

<div class="container py-4">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
      <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
      <li class="breadcrumb-item"><a href="/events" class="text-decoration-none">Events</a></li>
      <li class="breadcrumb-item active" aria-current="page"><%= event.title %></li>
    </ol>
  </nav>

  <div class="row g-4">
    <!-- Main Content Left Column -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="position-relative">
          <img src="<%= event.banner_image || 'https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=1200&q=80' %>" class="w-100" style="max-height: 380px; object-fit: cover;" alt="<%= event.title %>">
          <span class="badge bg-dark bg-opacity-75 text-white position-absolute top-0 start-0 m-3 px-3 py-2 fs-6">
            <i class="bi bi-tag-fill text-warning me-1"></i><%= event.category %>
          </span>
          <span class="badge <%= event.status === 'Upcoming' ? 'bg-success' : 'bg-secondary' %> position-absolute top-0 end-0 m-3 px-3 py-2 fs-6">
            <%= event.status %>
          </span>
        </div>

        <div class="card-body p-4 p-md-5">
          <h2 class="fw-bold text-dark mb-3"><%= event.title %></h2>

          <div class="row g-3 py-3 border-top border-bottom my-3">
            <div class="col-sm-6 col-md-3">
              <span class="text-muted small d-block"><i class="bi bi-calendar-event text-primary me-1"></i> Date</span>
              <strong class="text-dark"><%= event.event_date %></strong>
            </div>
            <div class="col-sm-6 col-md-3">
              <span class="text-muted small d-block"><i class="bi bi-clock text-primary me-1"></i> Time</span>
              <strong class="text-dark"><%= event.event_time %></strong>
            </div>
            <div class="col-sm-6 col-md-3">
              <span class="text-muted small d-block"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Venue</span>
              <strong class="text-dark"><%= event.venue_name || 'Campus Venue' %></strong>
            </div>
            <div class="col-sm-6 col-md-3">
              <span class="text-muted small d-block"><i class="bi bi-alarm text-warning me-1"></i> Deadline</span>
              <strong class="text-danger"><%= event.deadline %></strong>
            </div>
          </div>

          <h5 class="fw-bold mt-4 mb-2">About This Event</h5>
          <p class="text-secondary leading-relaxed" style="white-space: pre-line; font-size: 1.05rem;">
            <%= event.description %>
          </p>

          <h5 class="fw-bold mt-4 mb-2">Organizer Information</h5>
          <div class="p-3 bg-light rounded-3 d-flex align-items-center">
            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 me-3">
              <i class="bi bi-building fs-4"></i>
            </div>
            <div>
              <h6 class="fw-bold mb-0"><%= event.organizer %></h6>
              <span class="small text-muted">College Department & Event Committee</span>
            </div>
          </div>

          <h5 class="fw-bold mt-4 mb-2">Venue Details</h5>
          <div class="p-3 bg-light rounded-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-pin-map-fill text-danger me-1"></i> <%= event.venue_name %></h6>
              <span class="badge bg-secondary">Capacity: <%= event.venue_capacity || 'N/A' %> seats</span>
            </div>
            <p class="small text-muted mb-0"><%= event.venue_location || 'Campus Facilities' %></p>
          </div>
        </div>
      </div>

      <!-- Participant Feedback & Reviews -->
      <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="fw-bold mb-0">Participant Feedback & Ratings</h5>
          <% if (avgRating) { %>
            <div class="d-flex align-items-center gap-1">
              <span class="badge bg-warning text-dark fw-bold fs-6">
                <i class="bi bi-star-fill me-1"></i><%= avgRating %> / 5.0
              </span>
              <span class="text-muted small">(<%= totalRatings %> reviews)</span>
            </div>
          <% } %>
        </div>

        <% if (feedbacks && feedbacks.length > 0) { %>
          <div class="list-group list-group-flush">
            <% feedbacks.forEach(fb => { %>
              <div class="list-group-item px-0 py-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <div>
                    <strong class="text-dark"><%= fb.student_name %></strong>
                    <span class="small text-muted ms-2"><%= fb.student_department %></span>
                  </div>
                  <div class="text-warning">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <i class="bi <%= i <= fb.rating ? 'bi-star-fill' : 'bi-star' %>"></i>
                    <% } %>
                  </div>
                </div>
                <% if (fb.comment) { %>
                  <p class="text-secondary small mb-1"><%= fb.comment %></p>
                <% } %>
                <span class="text-muted small" style="font-size: 0.75rem;"><%= fb.submitted_at %></span>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-muted small mb-0 py-2">No reviews submitted yet for this event.</p>
        <% } %>
      </div>
    </div>

    <!-- Registration Sidebar Right Column -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 90px;">
        <div class="card-header bg-primary text-white py-3 rounded-top-4">
          <h5 class="fw-bold mb-0 text-center"><i class="bi bi-ticket-perforated me-2"></i>Event Registration</h5>
        </div>

        <div class="card-body p-4">
          <!-- Capacity meter -->
          <div class="mb-4">
            <div class="d-flex justify-content-between small text-muted mb-1">
              <span>Slots Registered</span>
              <span class="fw-bold text-dark"><%= event.registered_count %> / <%= event.max_participants %></span>
            </div>
            <% const pCent = Math.min(Math.round((event.registered_count / event.max_participants) * 100), 100); %>
            <div class="progress" style="height: 8px;">
              <div class="progress-bar <%= pCent >= 90 ? 'bg-danger' : 'bg-primary' %>" style="width: <%= pCent %>%;"></div>
            </div>
            <div class="small text-muted mt-1 text-end">
              <%= Math.max(0, event.max_participants - event.registered_count) %> seats remaining
            </div>
          </div>

          <!-- Registration Conditions Logic -->
          <% const todayDate = new Date().toISOString().split('T')[0]; %>
          <% const isExpired = event.deadline < todayDate; %>
          <% const isFull = event.registered_count >= event.max_participants; %>

          <% if (currentStudent) { %>
            <% if (studentRegistration && studentRegistration.status !== 'Cancelled') { %>
              <!-- Already Registered -->
              <div class="alert alert-success text-center">
                <i class="bi bi-check-circle-fill fs-3 d-block mb-1 text-success"></i>
                <h6 class="fw-bold mb-1">You Are Registered!</h6>
                <p class="small mb-2">Status: <span class="badge bg-success"><%= studentRegistration.status %></span></p>
                <div class="small text-muted mb-3">Ticket: <code><%= studentRegistration.ticket_code %></code></div>

                <a href="/student/ticket/<%= studentRegistration.id %>" class="btn btn-dark w-100 mb-2 fw-semibold">
                  <i class="bi bi-qr-code me-1"></i> View Digital Ticket (QR)
                </a>

                <% if (studentRegistration.status === 'Attended' || studentRegistration.status === 'Approved') { %>
                  <a href="/student/certificate/<%= studentRegistration.id %>" class="btn btn-outline-success w-100 mb-2 fw-semibold">
                    <i class="bi bi-award me-1"></i> Download Certificate
                  </a>
                <% } %>

                <form action="/student/events/<%= event.id %>/cancel" method="POST" onsubmit="return confirm('Are you sure you want to cancel your registration?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                    <i class="bi bi-x-circle me-1"></i> Cancel Registration
                  </button>
                </form>
              </div>

            <% } else if (isExpired) { %>
              <div class="alert alert-warning text-center">
                <i class="bi bi-exclamation-triangle-fill fs-4 d-block mb-2"></i>
                <strong>Registration Closed</strong>
                <p class="small mb-0">The deadline (<%= event.deadline %>) for this event has passed.</p>
              </div>

            <% } else if (isFull) { %>
              <div class="alert alert-danger text-center">
                <i class="bi bi-slash-circle-fill fs-4 d-block mb-2"></i>
                <strong>Event Full</strong>
                <p class="small mb-0">Maximum participant limit has been reached.</p>
              </div>

            <% } else { %>
              <!-- Available to Register -->
              <form action="/student/events/<%= event.id %>/register" method="POST">
                <div class="p-3 bg-light rounded-3 mb-3 small">
                  <div class="mb-1"><strong>Attendee:</strong> <%= currentStudent.name %></div>
                  <div class="mb-1"><strong>Roll No:</strong> <%= currentStudent.roll_no %></div>
                  <div><strong>Department:</strong> <%= currentStudent.department %></div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">
                  <i class="bi bi-check2-circle me-1"></i> Confirm Registration
                </button>
              </form>
            <% } %>

          <% } else if (currentAdmin) { %>
            <!-- Admin View -->
            <div class="alert alert-info">
              <h6 class="fw-bold mb-2"><i class="bi bi-shield-lock me-1"></i> Admin Management</h6>
              <p class="small mb-3">You are logged in with administrator privileges.</p>
              <div class="d-grid gap-2">
                <a href="/admin/events/<%= event.id %>/participants" class="btn btn-primary btn-sm fw-semibold">
                  <i class="bi bi-people-fill me-1"></i> View Participants (<%= event.registered_count %>)
                </a>
                <a href="/admin/events/<%= event.id %>/edit" class="btn btn-outline-secondary btn-sm fw-semibold">
                  <i class="bi bi-pencil-square me-1"></i> Edit Event
                </a>
              </div>
            </div>

          <% } else { %>
            <!-- Guest Prompt -->
            <div class="text-center">
              <p class="small text-muted mb-3">Please sign in with your student credentials to register for this event.</p>
              <a href="/auth/login?role=student" class="btn btn-primary w-100 mb-2 fw-semibold">
                <i class="bi bi-box-arrow-in-right me-1"></i> Student Sign In
              </a>
              <a href="/auth/register" class="btn btn-outline-secondary w-100 small">
                New Student? Register
              </a>
            </div>
          <% } %>

          <hr class="my-4">
          <div class="small text-muted">
            <div class="d-flex align-items-center mb-2">
              <i class="bi bi-shield-check text-success me-2 fs-5"></i>
              <span>Instant QR Entry Pass Issued</span>
            </div>
            <div class="d-flex align-items-center">
              <i class="bi bi-patch-check text-primary me-2 fs-5"></i>
              <span>Official Participation Certificate</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
