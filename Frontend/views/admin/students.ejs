<%- include('../partials/header') %>

<div class="container-fluid px-lg-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">Student Directory</h2>
      <p class="text-muted small mb-0">List of all registered students, department affiliation, and event registrations.</p>
    </div>
    <a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i> Dashboard
    </a>
  </div>

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4">Student Name</th>
            <th>Roll / Registration No</th>
            <th>Department</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Registered Events</th>
            <th>Attended Events</th>
            <th class="pe-4 text-end">Joined On</th>
          </tr>
        </thead>
        <tbody>
          <% if (students && students.length > 0) { %>
            <% students.forEach(s => { %>
              <tr>
                <td class="ps-4">
                  <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                      <i class="bi bi-person-fill"></i>
                    </div>
                    <strong><%= s.name %></strong>
                  </div>
                </td>
                <td><span class="badge bg-light text-dark border font-monospace"><%= s.roll_no %></span></td>
                <td class="small"><%= s.department %></td>
                <td class="small text-muted"><%= s.email %></td>
                <td class="small text-muted"><%= s.phone || 'N/A' %></td>
                <td>
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                    <%= s.reg_count %> registered
                  </span>
                </td>
                <td>
                  <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <%= s.attended_count %> attended
                  </span>
                </td>
                <td class="pe-4 text-end small text-muted"><%= s.created_at %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">No students registered yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
