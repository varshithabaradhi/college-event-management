<%- include('../partials/header') %>

<div class="container-fluid px-lg-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">Event Reports & Analytics</h2>
      <p class="text-muted small mb-0">Participation metrics, category breakdowns, and official CSV exports.</p>
    </div>
    <a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i> Dashboard
    </a>
  </div>

  <!-- Key Metrics Summary -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
        <h6 class="text-muted small mb-1">Total Organized Events</h6>
        <h2 class="fw-bold text-primary mb-0"><%= stats.totalEvents %></h2>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
        <h6 class="text-muted small mb-1">Total Registrations</h6>
        <h2 class="fw-bold text-dark mb-0"><%= stats.totalRegistrations %></h2>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
        <h6 class="text-muted small mb-1">Attended Participants</h6>
        <h2 class="fw-bold text-success mb-0"><%= stats.totalAttended %></h2>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
        <h6 class="text-muted small mb-1">Turnout / Attendance Rate</h6>
        <h2 class="fw-bold text-warning mb-0"><%= stats.attendanceRate %>%</h2>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- Category Distribution -->
    <div class="col-lg-5">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-header bg-white border-0 pt-4 px-4">
          <h5 class="fw-bold mb-0">Category Breakdown</h5>
        </div>
        <div class="card-body px-4 pb-4">
          <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
              <thead>
                <tr class="text-muted small">
                  <th>Category</th>
                  <th class="text-center">Events</th>
                  <th class="text-end">Registrations</th>
                </tr>
              </thead>
              <tbody>
                <% if (categoryStats && categoryStats.length > 0) { %>
                  <% categoryStats.forEach(c => { %>
                    <tr>
                      <td class="fw-semibold"><%= c.category %></td>
                      <td class="text-center"><span class="badge bg-light text-dark border"><%= c.event_count %></span></td>
                      <td class="text-end fw-bold text-primary"><%= c.total_regs || 0 %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="3" class="text-muted text-center">No data available</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Top Participated Events & CSV Download -->
    <div class="col-lg-7">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0">Event Participation Reports</h5>
          <span class="small text-muted">Download participant rosters</span>
        </div>
        <div class="card-body px-4 pb-4">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead>
                <tr class="text-muted small">
                  <th>Event Name</th>
                  <th>Date</th>
                  <th>Registrations</th>
                  <th>Attended</th>
                  <th class="text-end">Export</th>
                </tr>
              </thead>
              <tbody>
                <% if (topEvents && topEvents.length > 0) { %>
                  <% topEvents.forEach(evt => { %>
                    <tr>
                      <td class="fw-semibold text-truncate" style="max-width: 200px;"><%= evt.title %></td>
                      <td class="small text-muted"><%= evt.event_date %></td>
                      <td>
                        <span class="badge bg-light text-dark border"><%= evt.total_regs %> / <%= evt.max_participants %></span>
                      </td>
                      <td class="text-success fw-bold"><%= evt.attended_count %></td>
                      <td class="text-end">
                        <a href="/admin/events/<%= evt.id %>/export-csv" class="btn btn-sm btn-outline-success" title="Download CSV">
                          <i class="bi bi-download me-1"></i> CSV
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="5" class="text-center text-muted">No events recorded.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
