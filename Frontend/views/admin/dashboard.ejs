<%- include('../partials/header') %>

<div class="container-fluid px-lg-4 py-4">
  <!-- Admin Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
      <span class="badge bg-dark text-warning px-3 py-1 fw-bold mb-1">
        <i class="bi bi-shield-lock-fill me-1"></i> Control Center
      </span>
      <h2 class="fw-bold mb-0">Administrator Dashboard</h2>
      <p class="text-muted small mb-0">Overview of campus activities, student registrations, and venue management.</p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
      <a href="/admin/events/new" class="btn btn-warning fw-bold shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Add Event
      </a>
      <a href="/admin/qr-scanner" class="btn btn-dark fw-semibold shadow-sm">
        <i class="bi bi-qr-code-scan me-1 text-warning"></i> QR Check-in
      </a>
      <a href="/admin/reports" class="btn btn-outline-primary fw-semibold">
        <i class="bi bi-file-earmark-bar-graph me-1"></i> Reports
      </a>
    </div>
  </div>

  <!-- Metric Stat Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl">
      <div class="metric-card">
        <div class="metric-icon-box bg-primary bg-opacity-10 text-primary">
          <i class="bi bi-calendar-event"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0"><%= stats.totalEvents %></h3>
          <span class="text-muted small">Total Events</span>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl">
      <div class="metric-card">
        <div class="metric-icon-box bg-info bg-opacity-10 text-info">
          <i class="bi bi-calendar-check"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0"><%= stats.upcomingEvents %></h3>
          <span class="text-muted small">Upcoming Events</span>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl">
      <div class="metric-card">
        <div class="metric-icon-box bg-success bg-opacity-10 text-success">
          <i class="bi bi-people"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0"><%= stats.totalStudents %></h3>
          <span class="text-muted small">Registered Students</span>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl">
      <div class="metric-card">
        <div class="metric-icon-box bg-warning bg-opacity-10 text-warning">
          <i class="bi bi-ticket-perforated"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0"><%= stats.totalRegistrations %></h3>
          <span class="text-muted small">Total Bookings</span>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl">
      <div class="metric-card">
        <div class="metric-icon-box bg-purple bg-opacity-10 text-dark border">
          <i class="bi bi-patch-check-fill text-primary"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0"><%= stats.totalAttended %></h3>
          <span class="text-muted small">Attended Students</span>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- Recent Registrations -->
    <div class="col-xl-8">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
          <div>
            <h5 class="fw-bold mb-0">Recent Registrations</h5>
            <span class="text-muted small">Approve or update student attendance status</span>
          </div>
          <a href="/admin/events" class="small text-primary text-decoration-none fw-semibold">View Events &rarr;</a>
        </div>

        <div class="card-body px-0 pb-2">
          <% if (recentRegistrations && recentRegistrations.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th class="ps-4">Student</th>
                    <th>Roll No & Dept</th>
                    <th>Event</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Update Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% recentRegistrations.forEach(r => { %>
                    <tr>
                      <td class="ps-4">
                        <div class="fw-bold text-dark"><%= r.student_name %></div>
                        <span class="font-monospace text-primary small"><%= r.ticket_code %></span>
                      </td>
                      <td class="small">
                        <div class="badge bg-light text-dark border"><%= r.roll_no %></div>
                        <div class="text-muted" style="font-size: 0.75rem;"><%= r.department %></div>
                      </td>
                      <td class="small fw-semibold text-truncate" style="max-width: 180px;">
                        <%= r.event_title %>
                      </td>
                      <td>
                        <% if (r.status === 'Approved') { %>
                          <span class="badge bg-success-subtle text-success border border-success-subtle">Approved</span>
                        <% } else if (r.status === 'Attended') { %>
                          <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Attended</span>
                        <% } else if (r.status === 'Pending') { %>
                          <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Pending</span>
                        <% } else { %>
                          <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><%= r.status %></span>
                        <% } %>
                      </td>
                      <td class="text-end pe-4">
                        <form action="/admin/registrations/<%= r.id %>/status" method="POST" class="d-inline-flex gap-1">
                          <input type="hidden" name="redirect_to" value="/admin/dashboard">
                          <select name="status" class="form-select form-select-sm" onchange="this.form.submit()" style="width: auto;">
                            <option value="Approved" <%= r.status === 'Approved' ? 'selected' : '' %>>Approve</option>
                            <option value="Attended" <%= r.status === 'Attended' ? 'selected' : '' %>>Mark Attended</option>
                            <option value="Pending" <%= r.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                            <option value="Rejected" <%= r.status === 'Rejected' ? 'selected' : '' %>>Reject</option>
                          </select>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="text-center py-5 text-muted">
              No registrations recorded yet.
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Quick Navigation & Recent Events -->
    <div class="col-xl-4">
      <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-0 pt-4 px-4">
          <h5 class="fw-bold mb-0">Management Shortcuts</h5>
        </div>
        <div class="card-body px-4 pb-4">
          <div class="d-grid gap-2">
            <a href="/admin/events/new" class="btn btn-outline-primary text-start d-flex justify-content-between align-items-center p-3 rounded-3">
              <span><i class="bi bi-calendar-plus me-2 fs-5"></i> Create New Event</span>
              <i class="bi bi-chevron-right"></i>
            </a>
            <a href="/admin/qr-scanner" class="btn btn-outline-dark text-start d-flex justify-content-between align-items-center p-3 rounded-3">
              <span><i class="bi bi-qr-code-scan me-2 fs-5 text-warning"></i> QR Attendance Scanner</span>
              <i class="bi bi-chevron-right"></i>
            </a>
            <a href="/admin/students" class="btn btn-outline-secondary text-start d-flex justify-content-between align-items-center p-3 rounded-3">
              <span><i class="bi bi-people me-2 fs-5"></i> Student Directory</span>
              <i class="bi bi-chevron-right"></i>
            </a>
            <a href="/admin/venues" class="btn btn-outline-secondary text-start d-flex justify-content-between align-items-center p-3 rounded-3">
              <span><i class="bi bi-geo-alt me-2 fs-5"></i> Manage Campus Venues</span>
              <i class="bi bi-chevron-right"></i>
            </a>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0">Recent Events</h5>
          <a href="/admin/events" class="small text-primary text-decoration-none">All</a>
        </div>
        <div class="card-body px-4 pb-4">
          <% if (recentEvents && recentEvents.length > 0) { %>
            <div class="list-group list-group-flush">
              <% recentEvents.forEach(evt => { %>
                <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                  <div>
                    <h6 class="fw-bold mb-0 text-truncate" style="max-width: 180px;"><%= evt.title %></h6>
                    <span class="small text-muted"><%= evt.event_date %> &bull; <%= evt.reg_count %> registered</span>
                  </div>
                  <a href="/admin/events/<%= evt.id %>/participants" class="btn btn-sm btn-light border" title="Participants">
                    <i class="bi bi-people-fill"></i>
                  </a>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
