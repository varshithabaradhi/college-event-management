<%- include('../partials/header') %>

<div class="container-fluid px-lg-4 py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">Manage College Events</h2>
      <p class="text-muted small mb-0">Create, modify, monitor capacity, and manage participant registrations.</p>
    </div>
    <div class="mt-3 mt-md-0">
      <a href="/admin/events/new" class="btn btn-warning fw-bold shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Create New Event
      </a>
    </div>
  </div>

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4">Event Details</th>
            <th>Category</th>
            <th>Date & Time</th>
            <th>Venue</th>
            <th>Registrations</th>
            <th>Status</th>
            <th class="text-end pe-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (events && events.length > 0) { %>
            <% events.forEach(evt => { %>
              <tr>
                <td class="ps-4">
                  <div class="fw-bold text-dark"><%= evt.title %></div>
                  <span class="text-muted small d-block"><i class="bi bi-person me-1"></i> <%= evt.organizer %></span>
                </td>
                <td>
                  <span class="badge bg-secondary bg-opacity-10 text-secondary"><%= evt.category %></span>
                </td>
                <td class="small">
                  <div><i class="bi bi-calendar3 me-1 text-primary"></i> <%= evt.event_date %></div>
                  <span class="text-muted"><i class="bi bi-clock me-1"></i> <%= evt.event_time %></span>
                </td>
                <td class="small">
                  <div><%= evt.venue_name || 'Campus Venue' %></div>
                </td>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold"><%= evt.reg_count %> / <%= evt.max_participants %></span>
                    <% if (evt.attended_count > 0) { %>
                      <span class="badge bg-success-subtle text-success small" title="Attended participants">
                        <%= evt.attended_count %> checked in
                      </span>
                    <% } %>
                  </div>
                </td>
                <td>
                  <span class="badge <%= evt.status === 'Upcoming' ? 'bg-success' : (evt.status === 'Ongoing' ? 'bg-info' : 'bg-secondary') %>">
                    <%= evt.status %>
                  </span>
                </td>
                <td class="text-end pe-4">
                  <div class="d-inline-flex gap-1">
                    <a href="/admin/events/<%= evt.id %>/participants" class="btn btn-sm btn-primary" title="View & Manage Participants">
                      <i class="bi bi-people-fill me-1"></i> Attendees (<%= evt.reg_count %>)
                    </a>
                    <a href="/admin/events/<%= evt.id %>/edit" class="btn btn-sm btn-outline-secondary" title="Edit Event Details">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form action="/admin/events/<%= evt.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this event? All registrations will also be removed.');">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Event">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-5 text-muted">
                No events found. Click "Create New Event" to get started!
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
