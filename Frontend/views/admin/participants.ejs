<%- include('../partials/header') %>

<div class="container-fluid px-lg-4 py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <a href="/admin/events" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
        <h2 class="fw-bold mb-0">Participants: <%= event.title %></h2>
      </div>
      <p class="text-muted small mb-0 ms-4 ps-2">
        <%= event.event_date %> &bull; Venue: <%= event.venue_name || 'Main Hall' %> &bull; Registered: <strong><%= participants.length %></strong> / <%= event.max_participants %>
      </p>
    </div>

    <div class="d-flex gap-2 mt-3 mt-md-0">
      <a href="/admin/events/<%= event.id %>/export-csv" class="btn btn-success fw-semibold shadow-sm">
        <i class="bi bi-file-earmark-excel me-1"></i> Export CSV
      </a>
      <a href="/admin/qr-scanner" class="btn btn-dark fw-semibold shadow-sm">
        <i class="bi bi-qr-code-scan me-1 text-warning"></i> QR Check-in
      </a>
    </div>
  </div>

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4">Ticket Code</th>
            <th>Student Name</th>
            <th>Roll No</th>
            <th>Department</th>
            <th>Contact</th>
            <th>Registered At</th>
            <th>Status</th>
            <th class="text-end pe-4">Change Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (participants && participants.length > 0) { %>
            <% participants.forEach(p => { %>
              <tr>
                <td class="ps-4 font-monospace fw-bold text-primary">
                  <%= p.ticket_code %>
                </td>
                <td class="fw-bold text-dark"><%= p.student_name %></td>
                <td><span class="badge bg-light text-dark border"><%= p.roll_no %></span></td>
                <td class="small"><%= p.department %></td>
                <td class="small text-muted">
                  <div><i class="bi bi-envelope me-1"></i><%= p.student_email %></div>
                  <% if (p.phone) { %><div><i class="bi bi-telephone me-1"></i><%= p.phone %></div><% } %>
                </td>
                <td class="small text-muted"><%= p.registered_at %></td>
                <td>
                  <% if (p.status === 'Approved') { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Approved</span>
                  <% } else if (p.status === 'Attended') { %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                      <i class="bi bi-check2-all me-1"></i> Attended
                    </span>
                  <% } else if (p.status === 'Pending') { %>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Pending</span>
                  <% } else { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><%= p.status %></span>
                  <% } %>
                </td>
                <td class="text-end pe-4">
                  <form action="/admin/registrations/<%= p.id %>/status" method="POST" class="d-inline-flex gap-1">
                    <input type="hidden" name="redirect_to" value="/admin/events/<%= event.id %>/participants">
                    <select name="status" class="form-select form-select-sm" onchange="this.form.submit()" style="width: auto;">
                      <option value="Approved" <%= p.status === 'Approved' ? 'selected' : '' %>>Approve</option>
                      <option value="Attended" <%= p.status === 'Attended' ? 'selected' : '' %>>Mark Attended</option>
                      <option value="Pending" <%= p.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                      <option value="Rejected" <%= p.status === 'Rejected' ? 'selected' : '' %>>Reject</option>
                    </select>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                No students have registered for this event yet.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
