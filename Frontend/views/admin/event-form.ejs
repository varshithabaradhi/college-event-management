<%- include('../partials/header') %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-9">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="/admin/events" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-arrow-left me-1"></i> Back to Events
        </a>
      </div>

      <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-dark text-white py-3 px-4" style="background-color: #0f172a !important;">
          <h4 class="fw-bold mb-0">
            <i class="bi <%= event ? 'bi-pencil-square' : 'bi-plus-circle' %> text-warning me-2"></i>
            <%= event ? 'Edit Event Details' : 'Create New College Event' %>
          </h4>
        </div>

        <div class="card-body p-4 p-md-5">
          <form action="<%= event ? `/admin/events/${event.id}/edit` : '/admin/events/new' %>" method="POST">
            <div class="row g-3">
              <!-- Event Title -->
              <div class="col-12">
                <label class="form-label fw-semibold">Event Title *</label>
                <input type="text" name="title" class="form-control" placeholder="e.g. National Level Hackathon 2026" value="<%= event ? event.title : '' %>" required>
              </div>

              <!-- Category -->
              <div class="col-md-6">
                <label class="form-label fw-semibold">Event Category *</label>
                <select name="category" class="form-select" required>
                  <option value="" disabled <%= !event ? 'selected' : '' %>>Select Category</option>
                  <% ['Technical', 'Cultural', 'Workshop', 'Sports', 'Seminar', 'Symposium', 'Webinar'].forEach(cat => { %>
                    <option value="<%= cat %>" <%= event && event.category === cat ? 'selected' : '' %>><%= cat %></option>
                  <% }) %>
                </select>
              </div>

              <!-- Venue -->
              <div class="col-md-6">
                <label class="form-label fw-semibold">Venue *</label>
                <select name="venue_id" class="form-select" required>
                  <option value="" disabled <%= !event ? 'selected' : '' %>>Select Venue</option>
                  <% venues.forEach(v => { %>
                    <option value="<%= v.id %>" <%= event && event.venue_id === v.id ? 'selected' : '' %>>
                      <%= v.name %> (Capacity: <%= v.capacity %> seats)
                    </option>
                  <% }) %>
                </select>
              </div>

              <!-- Organizer -->
              <div class="col-md-6">
                <label class="form-label fw-semibold">Organizing Body / Department *</label>
                <input type="text" name="organizer" class="form-control" placeholder="e.g. Department of CSE / Student Council" value="<%= event ? event.organizer : '' %>" required>
              </div>

              <!-- Event Status -->
              <div class="col-md-6">
                <label class="form-label fw-semibold">Status *</label>
                <select name="status" class="form-select" required>
                  <% ['Upcoming', 'Ongoing', 'Completed', 'Cancelled'].forEach(st => { %>
                    <option value="<%= st %>" <%= event && event.status === st ? 'selected' : '' %>><%= st %></option>
                  <% }) %>
                </select>
              </div>

              <!-- Event Date -->
              <div class="col-md-6">
                <label class="form-label fw-semibold">Event Date *</label>
                <input type="date" name="event_date" class="form-control" value="<%= event ? event.event_date : '' %>" required>
              </div>

              <!-- Event Time -->
              <div class="col-md-6">
                <label class="form-label fw-semibold">Event Time *</label>
                <input type="text" name="event_time" class="form-control" placeholder="e.g. 10:00 AM or 02:30 PM" value="<%= event ? event.event_time : '10:00 AM' %>" required>
              </div>

              <!-- Max Participants -->
              <div class="col-md-6">
                <label class="form-label fw-semibold">Max Participants Limit *</label>
                <input type="number" name="max_participants" class="form-control" min="1" placeholder="e.g. 150" value="<%= event ? event.max_participants : '100' %>" required>
              </div>

              <!-- Registration Deadline -->
              <div class="col-md-6">
                <label class="form-label fw-semibold">Registration Deadline *</label>
                <input type="date" name="deadline" class="form-control" value="<%= event ? event.deadline : '' %>" required>
              </div>

              <!-- Banner Image URL -->
              <div class="col-12">
                <label class="form-label fw-semibold">Banner Image URL</label>
                <input type="url" name="banner_image" class="form-control" placeholder="https://images.unsplash.com/..." value="<%= event ? event.banner_image : '' %>">
                <span class="text-muted small">Enter a valid image URL for the event cover banner.</span>
              </div>

              <!-- Description -->
              <div class="col-12">
                <label class="form-label fw-semibold">Event Description & Rules *</label>
                <textarea name="description" class="form-control" rows="5" placeholder="Provide full details, eligibility, schedule, and guidelines for participants..." required><%= event ? event.description : '' %></textarea>
              </div>

              <!-- Submit Buttons -->
              <div class="col-12 mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-warning px-4 py-2 fw-bold text-dark shadow-sm">
                  <i class="bi bi-save me-1"></i> <%= event ? 'Update Event' : 'Publish Event' %>
                </button>
                <a href="/admin/events" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
