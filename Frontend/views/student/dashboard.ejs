<%- include('../partials/header') %>

<div class="container py-4">
  <!-- Welcome Banner -->
  <div class="card border-0 shadow-sm rounded-4 mb-4 text-white overflow-hidden" style="background: linear-gradient(135deg, #1e3a8a 0%, #0284c7 100%);">
    <div class="card-body p-4 p-md-5">
      <div class="row align-items-center">
        <div class="col-md-8">
          <span class="badge bg-white text-primary px-3 py-1 rounded-pill fw-bold mb-2">Student Portal</span>
          <h2 class="fw-bold mb-1">Welcome back, <%= currentStudent.name %>!</h2>
          <p class="mb-0 text-white-50">
            Roll No: <strong><%= currentStudent.roll_no %></strong> &bull; Department: <strong><%= currentStudent.department %></strong>
          </p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
          <a href="/events" class="btn btn-warning fw-bold px-4 shadow-sm">
            <i class="bi bi-compass me-1"></i> Browse Events
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Metric Counters -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="metric-card">
        <div class="metric-icon-box bg-primary bg-opacity-10 text-primary">
          <i class="bi bi-ticket-perforated"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0"><%= totalRegistered %></h3>
          <span class="text-muted small">Registered Events</span>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="metric-card">
        <div class="metric-icon-box bg-success bg-opacity-10 text-success">
          <i class="bi bi-award"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0"><%= attendedCount %></h3>
          <span class="text-muted small">Events Attended</span>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="metric-card">
        <div class="metric-icon-box bg-warning bg-opacity-10 text-warning">
          <i class="bi bi-bell"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0"><%= unreadNotifs %></h3>
          <span class="text-muted small">Unread Notifications</span>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- Left Column: Upcoming Registered Events -->
    <div class="col-lg-7">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0">Your Upcoming Events</h5>
          <a href="/student/my-events" class="small text-primary text-decoration-none fw-semibold">View All</a>
        </div>
        <div class="card-body px-4 pb-4">
          <% if (upcomingEvents && upcomingEvents.length > 0) { %>
            <div class="list-group list-group-flush">
              <% upcomingEvents.forEach(evt => { %>
                <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                  <div>
                    <span class="badge bg-info bg-opacity-10 text-info mb-1"><%= evt.category %></span>
                    <h6 class="fw-bold mb-1 text-dark"><%= evt.title %></h6>
                    <span class="small text-muted">
                      <i class="bi bi-calendar3 me-1"></i><%= evt.event_date %> at <%= evt.event_time %> &bull; <i class="bi bi-geo-alt me-1"></i><%= evt.venue_name || 'Campus' %>
                    </span>
                  </div>
                  <div class="text-end">
                    <span class="badge <%= evt.reg_status === 'Approved' ? 'bg-success' : 'bg-warning text-dark' %> mb-2 d-block">
                      <%= evt.reg_status %>
                    </span>
                    <a href="/student/ticket/<%= evt.id %>" class="btn btn-sm btn-outline-dark">
                      <i class="bi bi-qr-code"></i> Pass
                    </a>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="text-center py-5">
              <i class="bi bi-calendar-x fs-1 text-muted mb-2 d-block"></i>
              <p class="text-muted mb-3">You haven't registered for any upcoming events yet.</p>
              <a href="/events" class="btn btn-outline-primary btn-sm">Explore Campus Events</a>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Right Column: Recommended Events to Register -->
    <div class="col-lg-5">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-header bg-white border-0 pt-4 px-4">
          <h5 class="fw-bold mb-0">Recommended for You</h5>
        </div>
        <div class="card-body px-4 pb-4">
          <% if (availableEvents && availableEvents.length > 0) { %>
            <div class="d-flex flex-column gap-3">
              <% availableEvents.forEach(e => { %>
                <div class="p-3 border rounded-3 bg-light">
                  <span class="badge bg-dark mb-1"><%= e.category %></span>
                  <h6 class="fw-bold mb-1"><%= e.title %></h6>
                  <p class="small text-muted mb-2"><i class="bi bi-calendar-event me-1"></i><%= e.event_date %> &bull; <%= e.venue_name || 'Main Hall' %></p>
                  <a href="/events/<%= e.id %>" class="btn btn-sm btn-primary fw-semibold">
                    Register Now
                  </a>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-muted small">No other events currently open for registration.</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
