<%- include('../partials/header') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">My Registered Events</h2>
      <p class="text-muted mb-0">Manage your event registrations, access QR entry passes, and download certificates.</p>
    </div>
    <a href="/events" class="btn btn-outline-primary fw-semibold">
      <i class="bi bi-search me-1"></i> Find More Events
    </a>
  </div>

  <% if (registrations && registrations.length > 0) { %>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Ticket Code</th>
              <th>Event</th>
              <th>Date & Time</th>
              <th>Venue</th>
              <th>Status</th>
              <th class="text-end pe-4">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% registrations.forEach(reg => { %>
              <tr>
                <td class="ps-4 font-monospace fw-bold text-primary">
                  <%= reg.ticket_code %>
                </td>
                <td>
                  <a href="/events/<%= reg.event_id %>" class="text-decoration-none fw-bold text-dark hover-primary d-block">
                    <%= reg.event_title %>
                  </a>
                  <span class="badge bg-secondary bg-opacity-10 text-secondary" style="font-size: 0.7rem;"><%= reg.category %></span>
                </td>
                <td class="small">
                  <div><i class="bi bi-calendar3 me-1 text-primary"></i> <%= reg.event_date %></div>
                  <div class="text-muted"><i class="bi bi-clock me-1"></i> <%= reg.event_time %></div>
                </td>
                <td class="small">
                  <div><%= reg.venue_name || 'Campus Venue' %></div>
                  <span class="text-muted" style="font-size: 0.75rem;"><%= reg.venue_location || '' %></span>
                </td>
                <td>
                  <% if (reg.status === 'Approved') { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                      <i class="bi bi-check-circle me-1"></i> Approved
                    </span>
                  <% } else if (reg.status === 'Attended') { %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                      <i class="bi bi-patch-check-fill me-1"></i> Attended
                    </span>
                  <% } else if (reg.status === 'Pending') { %>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                      <i class="bi bi-hourglass-split me-1"></i> Pending
                    </span>
                  <% } else { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                      <i class="bi bi-x-circle me-1"></i> <%= reg.status %>
                    </span>
                  <% } %>
                </td>
                <td class="text-end pe-4">
                  <div class="d-inline-flex gap-1">
                    <% if (reg.status !== 'Cancelled') { %>
                      <!-- View Ticket QR -->
                      <a href="/student/ticket/<%= reg.id %>" class="btn btn-sm btn-dark" title="View Digital QR Pass">
                        <i class="bi bi-qr-code"></i> Pass
                      </a>

                      <!-- Certificate Download -->
                      <% if (reg.status === 'Attended' || reg.status === 'Approved') { %>
                        <a href="/student/certificate/<%= reg.id %>" class="btn btn-sm btn-outline-success" title="Download Verified Certificate">
                          <i class="bi bi-award-fill"></i> Certificate
                        </a>
                      <% } %>

                      <!-- Feedback Modal Trigger -->
                      <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#feedbackModal<%= reg.event_id %>" title="Give Feedback">
                        <i class="bi bi-star-fill"></i>
                      </button>

                      <!-- Cancel Registration Button -->
                      <% if (reg.status !== 'Attended') { %>
                        <form action="/student/events/<%= reg.event_id %>/cancel" method="POST" class="d-inline" onsubmit="return confirm('Cancel this registration?');">
                          <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancel Registration">
                            <i class="bi bi-x-lg"></i>
                          </button>
                        </form>
                      <% } %>
                    <% } else { %>
                      <span class="text-muted small">Cancelled</span>
                    <% } %>
                  </div>

                  <!-- Feedback Modal for this Event -->
                  <div class="modal fade text-start" id="feedbackModal<%= reg.event_id %>" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content rounded-4 border-0 shadow">
                        <form action="/student/feedback" method="POST">
                          <input type="hidden" name="event_id" value="<%= reg.event_id %>">

                          <div class="modal-header">
                            <h5 class="modal-title fw-bold"><i class="bi bi-chat-heart text-warning me-2"></i>Event Feedback</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                          </div>
                          <div class="modal-body p-4">
                            <h6 class="fw-bold mb-3"><%= reg.event_title %></h6>
                            
                            <div class="mb-3">
                              <label class="form-label small fw-semibold">Your Rating *</label>
                              <select name="rating" class="form-select" required>
                                <option value="5" <%= reg.user_rating === 5 ? 'selected' : '' %>>⭐⭐⭐⭐⭐ (5 Stars - Outstanding)</option>
                                <option value="4" <%= reg.user_rating === 4 ? 'selected' : '' %>>⭐⭐⭐⭐ (4 Stars - Very Good)</option>
                                <option value="3" <%= reg.user_rating === 3 ? 'selected' : '' %>>⭐⭐⭐ (3 Stars - Good)</option>
                                <option value="2" <%= reg.user_rating === 2 ? 'selected' : '' %>>⭐⭐ (2 Stars - Fair)</option>
                                <option value="1" <%= reg.user_rating === 1 ? 'selected' : '' %>>⭐ (1 Star - Poor)</option>
                              </select>
                            </div>

                            <div class="mb-3">
                              <label class="form-label small fw-semibold">Feedback & Suggestions</label>
                              <textarea name="comment" class="form-control" rows="3" placeholder="Share your experience, organization feedback, or key takeaways..."><%= reg.user_feedback || '' %></textarea>
                            </div>
                          </div>
                          <div class="modal-footer bg-light rounded-bottom-4">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-primary fw-semibold">Submit Feedback</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
      <i class="bi bi-calendar2-plus text-primary fs-1 mb-3"></i>
      <h4 class="fw-bold">No Registrations Yet</h4>
      <p class="text-muted mb-4">You have not registered for any events yet. Check out the latest campus events!</p>
      <div>
        <a href="/events" class="btn btn-primary px-4 fw-semibold">Browse Available Events</a>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
